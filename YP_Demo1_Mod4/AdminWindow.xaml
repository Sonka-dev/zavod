<Window x:Class="YP_Demo1_Mod4.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:YP_Demo1_Mod4"
        mc:Ignorable="d"
        Title="AdminWindow"
        Width="1050" Height="680" MinWidth="850" MinHeight="600" WindowStartupLocation="CenterScreen" Background="#F4F7FB">
    <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="WelcomeText" FontSize="27" FontWeight="Bold" Margin="0,0,0,20"/>
            <Grid x:Name="AdminPanel" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>
                <DataGrid x:Name="UsersGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionChanged="UsersGrid_SelectionChanged" Margin="0,0,20,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Логин" Binding="{Binding login}" Width="*"/>
                        <DataGridTextColumn Header="Роль" Binding="{Binding post}" Width="*"/>
                        <DataGridCheckBoxColumn Header="Блокировка" Binding="{Binding IsBlocked}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Column="1" Background="White" Padding="18" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="Управление пользователями" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock Text="Логин" Margin="0,18,0,4"/>
                        <TextBox x:Name="UserLogin" Height="32"/>
                        <TextBlock Text="Пароль (при изменении можно оставить пустым)" TextWrapping="Wrap" Margin="0,12,0,4"/>
                        <PasswordBox x:Name="UserPassword" Height="32"/>
                        <TextBlock Text="Роль" Margin="0,12,0,4"/>
                        <ComboBox x:Name="UserRole" Height="32" SelectedIndex="1">
                            <ComboBoxItem Content="Admin"/>
                            <ComboBoxItem Content="user"/>
                        </ComboBox>
                        <CheckBox x:Name="UserBlocked" Content="Заблокирован" Margin="0,18,0,8"/>
                        <Button Content="Добавить нового" Height="38" Margin="0,12,0,0" Click="AddUser_Click"/>
                        <Button Content="Сохранить выбранного" Height="38" Margin="0,12,0,0" Click="SaveUser_Click"/>
                        <Button Content="Очистить форму" Height="38" Margin="0,12,0,0" Click="ClearForm_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
    </Grid>

</Window>
