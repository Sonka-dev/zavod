<Window x:Class="YP_Demo1_Mod4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:YP_Demo1_Mod4"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel Margin="10" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Orientation="Vertical" Margin="25">
            <StackPanel Orientation="Horizontal" Margin="25, 10"> 
                <TextBlock Text="Login" Margin="0,0,10,0"/>
                <TextBox x:Name="loginTxt" Width="200"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="25, 10">
                <TextBlock Text="Password" Margin="0,0,10,0"/>
                <TextBox x:Name="passTxt" Width="200"/>
            </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <Border BorderBrush="Black" BorderThickness="1" Width="100">
                    <Button Click="SwitchImage" Background="Transparent" Tag="img1" >
                        <Image x:Name="img1" Width="100"/>
                    </Button>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Width="100">
                    <Button Click="SwitchImage" Background="Transparent" Tag="img2">
                        <Image x:Name="img2" Width="100"/>
                    </Button>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Border BorderBrush="Black" BorderThickness="1" Width="100">
                    <Button Click="SwitchImage" Background="Transparent" Tag="img3">
                        <Image x:Name="img3" Width="100"/>
                    </Button>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Width="100">
                    <Button Click="SwitchImage" Background="Transparent" Tag="img4">
                        <Image x:Name="img4" Width="100"/>
                    </Button>
                </Border>
            </StackPanel>
        </StackPanel>
        <Button Content="Войти" Margin="25" Width="120" Height="30"
                Click="Autorization_Click"/>
    </StackPanel>
</Window>
